<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".LoginActivity">

    <!-- Decorative Top Right Shape -->
    <View
        android:id="@+id/top_shape"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-40dp"
        android:background="@drawable/shape_accent"
        android:rotation="20" />

    <!-- Decorative Bottom Left Shape -->
    <View
        android:id="@+id/bottom_shape"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="-30dp"
        android:layout_marginStart="-30dp"
        android:background="@drawable/shape_accent"
        android:rotation="45" />

    <!-- Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/please_sign_in"
            android:textSize="14sp"
            android:textColor="@color/gray_text"
            android:layout_marginBottom="40dp" />

        <!-- Email Field Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_rounded_card"
            android:padding="16dp"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_email"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/email" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="user123@gmail.com"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:background="@null"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress" />
        </LinearLayout>

        <!-- Password Field Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_rounded_card"
            android:padding="16dp"
            android:elevation="8dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_lock"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/password" />

            <EditText
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/password"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:background="@null"
                android:inputType="textPassword"
                android:autofillHints="password" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forgot"
                android:textColor="@color/orange_main"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Shiny Login Button -->
        <FrameLayout
            android:id="@+id/btn_login_container"
            android:layout_width="160dp"
            android:layout_height="56dp"
            android:layout_gravity="end"
            android:layout_marginTop="32dp"
            android:clipChildren="true">

            <!-- Main Button Background and Content -->
            <LinearLayout
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_button_login"
                android:gravity="center"
                android:orientation="horizontal"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_forward"
                    android:contentDescription="@string/login" />
            </LinearLayout>

            <!-- The Shine Overlay View -->
            <View
                android:id="@+id/shine_view"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:background="@drawable/button_shine"
                android:rotation="25"
                android:layout_marginStart="-100dp" />

        </FrameLayout>

    </LinearLayout>

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dont_have_account"
            android:textColor="@color/gray_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sign_up_text"
            android:textColor="@color/orange_main"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>