<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="btnCircleBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">6dp</item> <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>

        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="btnBlack" parent="btnCircleBase">
        <item name="android:background">@drawable/btn_circle_black</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="btnGray" parent="btnCircleBase">
        <item name="android:background">@drawable/btn_circle_gray</item>
        <item name="android:textColor">#313131</item> </style>

    <style name="btnPink" parent="btnCircleBase">
        <item name="android:background">@drawable/btn_circle_pink</item>
        <item name="android:textColor">#78007A</item> </style>

    <style name="btnPurple" parent="btnCircleBase">
        <item name="android:background">@drawable/btn_circle_purple</item>
        <item name="android:textColor">#D9D9D9</item> </style>
</resources>